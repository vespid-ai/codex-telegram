TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional. Useful when api.telegram.org is not reachable directly.
# Example: TELEGRAM_PROXY=http://127.0.0.1:2333
TELEGRAM_PROXY=

# Working directory used when a Telegram topic creates its first Codex session.
CODEX_WORKSPACE=/Users/mangaohua/Documents/codex-telegram

# Optional Codex settings. Leave blank to inherit ~/.codex/config.toml defaults.
CODEX_BIN=codex
# Normal Telegram text turns use exec by default. Set to app-server to route
# normal messages, /new <prompt>, and /resume <id> <prompt> through app-server.
CODEX_TEXT_RUNNER=exec
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
# Optional. Defaults to $CODEX_HOME/state_5.sqlite or ~/.codex/state_5.sqlite.
CODEX_STATE_DB=

# Telegram voice support. Voice input uses codex app-server realtime.
VOICE_DIR=./data/voice
FFMPEG_BIN=ffmpeg
CODEX_REALTIME_VOICE=
CODEX_REALTIME_TIMEOUT_SECONDS=120

# Bot runtime state.
STATE_FILE=./data/state.json
MAX_TELEGRAM_CHARS=3800
STATUS_UPDATE_SECONDS=30
